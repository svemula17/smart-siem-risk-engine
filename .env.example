# SmartSIEM Risk Engine — environment configuration
# Copy to .env and adjust. Every value here has a safe default for local dev.

# ── Core ─────────────────────────────────────────────────────────────────────
# SQLAlchemy database URL. SQLite by default; PostgreSQL works too.
DATABASE_URL=sqlite:///smart_siem.db

# Secret used for signing/session hardening. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Authentication ───────────────────────────────────────────────────────────
# Initial admin password. If unset, a random password is generated and printed
# to the console once on first boot.
ADMIN_PASSWORD=

# Session lifetime in hours.
SESSION_TTL_HOURS=8

# Set to 1 when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=0

# Comma-separated list of allowed CORS origins. Empty = same-origin only.
CORS_ORIGINS=

# Shared token protecting the internal broadcast endpoint used by the demo
# pipeline subprocess. Auto-generated at boot if unset.
INTERNAL_API_TOKEN=

# ── Demo behavior ────────────────────────────────────────────────────────────
# DEMO_MODE=1 enables replay-on-refresh: opening /dashboard wipes alert tables
# and re-runs the pipeline so alerts stream in live. Never enable in production.
DEMO_MODE=1

# Auto-start the alert pipeline subprocess on server boot.
AUTO_PIPELINE=1

# ── Integrations (all optional) ──────────────────────────────────────────────
# Claude AI incident summaries / investigator chat.
ANTHROPIC_API_KEY=

# Live threat-intel feeds. Leave empty to disable syncing.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
THREAT_FEED_SYNC_MINUTES=60

# Slack / Discord webhook notifications.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── Syslog ingestion ─────────────────────────────────────────────────────────
SYSLOG_ENABLED=0
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5515
